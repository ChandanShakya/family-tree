{
	"name": "family-tree",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"check:ci": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p tsconfig.tsc.json",
		"test": "vitest run",
		"test:e2e": "playwright test --reporter=line",
		"test:e2e:setup": "playwright install --with-deps chromium",
		"lint": "eslint .",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx scripts/migrate.ts",
		"contrast": "tsx scripts/contrast.ts",
		"bench": "tsx scripts/bench.ts",
		"seed": "tsx scripts/seed.ts",
		"rebuild-fts": "tsx scripts/rebuild-fts.ts",
		"sweep-orphans": "tsx scripts/sweep-orphans.ts",
		"check:traceability": "node scripts/check-traceability.mjs",
		"build": "vite build",
		"preview": "vite preview",
		"backup": "tsx scripts/backup.ts",
		"restore": "tsx scripts/restore.ts"
	},
	"dependencies": {
		"@internationalized/date": "3.12.4",
		"@lucide/svelte": "1.49.0",
		"@sveltejs/adapter-node": "5.5.7",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.3",
		"bcryptjs": "3.0.3",
		"better-sqlite3": "13.0.3",
		"bits-ui": "2.19.4",
		"cn": "0.4.0",
		"d3-selection": "3.0.0",
		"d3-shape": "3.2.0",
		"d3-zoom": "3.0.0",
		"drizzle-orm": "0.45.3",
		"nepali-date-converter": "3.4.0",
		"nodemailer": "10.0.13",
		"sharp": "0.35.5",
		"svelte": "5.57.1",
		"tailwind-variants": "3.3.1",
		"tailwindcss": "4.3.3",
		"tar-stream": "3.2.1",
		"tsx": "4.23.15",
		"vite": "8.3.1",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@eslint/js": "10.0.1",
		"@playwright/test": "1.63.0",
		"@types/better-sqlite3": "9.6.0",
		"@types/d3-selection": "3.0.12",
		"@types/d3-zoom": "3.0.9",
		"@types/node": "26.6.3",
		"drizzle-kit": "0.31.11",
		"eslint": "10.11.0",
		"eslint-plugin-svelte": "3.23.0",
		"globals": "17.12.0",
		"shadcn-svelte": "1.7.0",
		"svelte-check": "4.7.6",
		"tw-animate-css": "1.4.0",
		"typescript": "7.0.2",
		"typescript-eslint": "8.71.0",
		"vitest": "5.0.3"
	}
}
