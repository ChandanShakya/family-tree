{
	"name": "family-tree",
	"version": "0.2.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"check:ci": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p tsconfig.tsc.json",
		"test": "vitest run --exclude tests/import-load.test.ts && vitest run tests/import-load.test.ts",
		"test:e2e": "playwright test --reporter=line",
		"test:e2e:setup": "playwright install --with-deps chromium",
		"lint": "eslint .",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx scripts/migrate.ts",
		"contrast": "tsx scripts/contrast.ts",
		"bench": "tsx scripts/bench.ts",
		"seed": "tsx scripts/seed.ts",
		"rebuild-fts": "tsx scripts/rebuild-fts.ts",
		"sweep-orphans": "tsx scripts/sweep-orphans.ts",
		"check:traceability": "node scripts/check-traceability.mjs",
		"build": "vite build",
		"preview": "vite preview",
		"backup": "tsx scripts/backup.ts",
		"restore": "tsx scripts/restore.ts"
	},
	"dependencies": {
		"@internationalized/date": "3.12.4",
		"@lucide/svelte": "1.61.0",
		"@sveltejs/adapter-node": "6.0.0",
		"@sveltejs/kit": "3.1.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.3",
		"bcryptjs": "3.0.3",
		"better-sqlite3": "13.0.3",
		"bits-ui": "2.20.2",
		"cn": "0.5.0",
		"d3-selection": "3.0.0",
		"d3-shape": "3.2.0",
		"d3-zoom": "3.0.0",
		"drizzle-orm": "0.45.4",
		"nepali-date-converter": "3.4.0",
		"nodemailer": "10.2.1",
		"sharp": "0.35.5",
		"svelte": "5.57.3",
		"tailwind-variants": "3.3.1",
		"tailwindcss": "4.3.3",
		"tar-stream": "3.2.2",
		"tsx": "4.23.15",
		"vite": "8.3.5",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"@eslint/js": "10.0.1",
		"@playwright/test": "1.64.1",
		"@types/better-sqlite3": "9.6.0",
		"@types/d3-selection": "3.0.12",
		"@types/d3-zoom": "3.0.9",
		"@types/node": "22.20.5",
		"drizzle-kit": "0.31.11",
		"eslint": "10.13.0",
		"eslint-plugin-svelte": "3.23.1",
		"globals": "17.13.0",
		"shadcn-svelte": "1.7.1",
		"svelte-check": "4.7.7",
		"tw-animate-css": "1.4.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.1",
		"vitest": "5.0.5"
	},
	"overrides": {
		"@esbuild-kit/core-utils": {
			"esbuild": "0.28.2"
		},
		"@sveltejs/kit": "$@sveltejs/kit"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
