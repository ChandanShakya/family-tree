# Copy to .env (docker compose reads it). Never commit .env.
# Full reference: docs/configuration.md

# Public https URL of the site, no trailing slash.
ORIGIN=https://tree.example.com

# At least 32 random characters each; generate with: openssl rand -base64 48
# The app refuses to start in production without them. Never change VERIFICATION_PEPPER later.
SESSION_SECRET=change-me-to-32-or-more-random-characters
VERIFICATION_PEPPER=change-me-to-32-or-more-random-characters

# Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel -> token.
CLOUDFLARE_TUNNEL_TOKEN=

# Mail (strongly recommended). Without it, reset and verification links go to the server log.
# Port 587 uses STARTTLS (required); 465 uses TLS. SMTP_FROM must be a sender your provider verified.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Family Tree <noreply@example.com>

# Optional Google sign-in. Redirect URI: ${ORIGIN}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
